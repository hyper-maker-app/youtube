# Copy this file to .env. Never commit .env or place credentials in Python source.
# Select exactly one provider per capability. The provider factory never falls back.

# Provider selection (YOUTUBE_STUDIO Active Providers)
LLM_PROVIDER=grok
IMAGE_PROVIDER=playwright_flow
VIDEO_PROVIDER=playwright_flow
SFX_PROVIDER=gradio_space
SFX_SPACE_URL=fffiloni/audiogen
SFX_FALLBACK_SPACE_URL=declare-lab/TangoFlux
SFX_MANIFEST_PATH=assets/sfx/catalog.json
MMAUDIO_MODE=local
MMAUDIO_SPACE_URL=hkchengrex/MMAudio
MMAUDIO_DEVICE=cuda
TTS_PROVIDER=

# Legacy direct Gemini API mode. Vertex production uses the ADC-based settings below.
GEMINI_API_KEY=
GEMINI_MODEL=

# xAI Grok mode (Grok-2 / Grok-2-1212 for cinematic scenario & direction)
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_API_BASE=https://api.x.ai/v1

# Vertex / Veo. ADC credentials are supplied by gcloud, never by a JSON key in this repo.
GOOGLE_CLOUD_PROJECT=
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_CLOUD_LOCATION=
VERTEX_TEXT_LOCATION=
# Nano Banana Pro keyframes are routed separately from the regional Veo endpoint.
NANO_BANANA_PRO_LOCATION=global
# Recommended production trio: Gemini 3.8 Flash (script), Nano Banana Pro
# for every roster/keyframe, and standard Veo 3.1 Generate motion (not Fast).
VERTEX_TEXT_MODEL=gemini-3.8-flash
# Retry only transient Vertex capacity rejections; no model/provider fallback.
VERTEX_TEXT_429_RETRIES=2
VERTEX_TEXT_429_BACKOFF_SECONDS=3
VERTEX_OPERATION_TIMEOUT_SECONDS=1200
VERTEX_OPERATION_POLL_SECONDS=10
NANO_BANANA_PRO_MODEL=gemini-3-pro-image
VERTEX_VIDEO_MODEL=veo-3.1-generate-001
# Nano Banana Pro capacity guard: limits request starts and retries only 429/RESOURCE_EXHAUSTED.
NANO_BANANA_PRO_MAX_CONCURRENCY=1
NANO_BANANA_PRO_MIN_INTERVAL_SECONDS=1.0
NANO_BANANA_PRO_429_RETRIES=4
NANO_BANANA_PRO_429_BACKOFF_SECONDS=2.0
# Fail visibly rather than hanging if a synchronous image request never returns.
NANO_BANANA_PRO_REQUEST_TIMEOUT_SECONDS=120
KEYFRAME_ADMISSION_ATTEMPTS=3
# When true, relabels scale_transition or subject_change to same_subject after exhausted attempts.
KEYFRAME_FALLBACK_RELABEL=true
# When true, explicitly permits image providers without review_keyframe to bypass visual review.
ALLOW_UNREVIEWED_KEYFRAMES=false

# Google Flow Agent. CLI wins when both CLI and session configuration exist.
FLOW_AGENT_SESSION_TOKEN=
# Explicit hash-checked source build. Runtime remains blocked under the no-spoof policy.
FLOW_AGENT_CLI_PATH=
# Runtime account/output directory, outside the source-only integration shim.
FLOW_AGENT_ROOT=
FLOW_AGENT_BASE_URL=http://127.0.0.1:8001
FLOW_VIDEO_MODEL=gemini_omni_flash_1_1
FLOW_VIDEO_REAL_QUALITY=720p
FLOW_VIDEO_TEST_QUALITY=360p
FLOW_IMAGE_MODEL=nano_banana_pro
FLOW_IMAGE_FALLBACK_MODEL=
FLOW_ALLOWED_DURATIONS=4,6,8,10
FLOW_DURATION_POLICY=adaptive_native_v1
# No broker/token minting is authorized by the current transport validation contract.
FLOW_RECAPTCHA=off

# Fal video: h3_max | kling_pro | veo_fast | hailuo | wan
FAL_KEY=
FAL_QUEUE_BASE_URL=
FAL_VIDEO_MODEL=h3_max

# Deepgram Aura
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_VOICE_MODEL=aura-2-hermes-en
DEEPGRAM_LONGFORM_VOICE_MODEL=aura-2-hera-en
DEEPGRAM_WITNESS_VOICE_MODEL=aura-2-hermes-en
DEEPGRAM_TRANSCRIBE_MODEL=nova-3
DEEPGRAM_MODEL=
DEEPGRAM_TTS_SPEED=
DEEPGRAM_TTS_EXPRESSIVITY=0
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_CONTAINER=wav
DEEPGRAM_TTS_SAMPLE_RATE=48000
DEEPGRAM_ENGLISH_WPS=
# Deepgram Flux Multi-Voice Roster (Round-robin auxiliary voices with Entity Lock)
DEEPGRAM_FLUX_ROSTER=false
DEEPGRAM_FLUX_SPEAK_VERSION=v2

# Edge TTS
EDGE_TTS_VOICE=

# Azure Neural TTS
AZURE_TTS_KEY=your_key_here
AZURE_TTS_REGION=eastus
AZURE_TTS_VOICE=en-US-GuyNeural

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVEN_MODEL=
ELEVEN_VOICE_ID=

# Legacy/optional adapters retained in config.py compatibility paths
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_VISION_BASE_URL=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=
ANTHROPIC_QUALITY_FALLBACK_MODEL=
ANTHROPIC_SCRIPT_MAX_TOKENS=
OPENAI_API_KEY=
OPENAI_MODEL=
CODEFAST_API_KEY=
CODEFAST_BASE_URL=
CODEFAST_MODEL=
SEEKAI_API_KEY=
SEEKAI_BASE_URL=
SEEKAI_MODEL=
SESLAB_API_KEY=
SESLAB_BASE_URL=
SESLAB_VOICE_ID=
SESLAB_VOICE_PACKAGE=
VOYSLITY_API_KEY=
VOYSLITY_BASE_URL=
VOYSLITY_VOICE_ID=
VOYSLITY_MODEL_ID=

# Legacy Vertex planning/review settings. The current modular pipeline does not
# require these for its normal provider-factory path.
CALIBRATION_MODE=
CALIBRATION_MAX_ATTEMPTS=
VERTEX_HERO_VIDEO_MODEL=
VERTEX_TEXT_MAX_OUTPUT_TOKENS=
VERTEX_TEXT_TIMEOUT_SECONDS=
VERTEX_KEYFRAME_PREFLIGHT_MODEL=
VERTEX_KEYFRAME_PREFLIGHT_LOCATION=
VERTEX_KEYFRAME_PREFLIGHT_MAX_OUTPUT_TOKENS=
VERTEX_KEYFRAME_PREFLIGHT_429_RETRIES=
VERTEX_KEYFRAME_PREFLIGHT_429_BACKOFF_SECONDS=
VERTEX_CLIP_REVIEW_MODEL=
VERTEX_CLIP_REVIEW_LOCATION=
VERTEX_CLIP_REVIEW_MAX_OUTPUT_TOKENS=
VERTEX_MAX_HERO_KEYFRAMES=
SCRIPT_REPAIR_ATTEMPTS=
FFMPEG_BINARY=
VERTEX_VEO_MAX_CONCURRENT_BLOCKS=1
LONGFORM_MODE=
PRODUCTION_FORMAT=
EXPLORER_CHARACTER_NAME=
LONGFORM_HYBRID_MODE=
ANTIGRAVITY_BRAIN_DIR=
FLOW_AGENT_OUTPUT_DIR=


# Playwright CDP Configuration (Strategy 1 - background Flow automation)
PLAYWRIGHT_CDP_PORT=9223
FLOW_CHROME_BATCH_PATH=
FLOW_CDP_START_TIMEOUT_SECONDS=45
FLOW_CDP_POLL_INTERVAL_SECONDS=0.5
FLOW_AUTOSTART=true
# Set VIDEO_PROVIDER=playwright_flow and IMAGE_PROVIDER=playwright_flow to use CDP automation
# First run chrome_flow.bat to start Chrome with CDP enabled, then sign into flow.google.com

# Fal.ai aspect ratio (default 9:16 for Shorts; set to 16:9 for longform)
FAL_ASPECT_RATIO=9:16

# Motion Authenticity & Quality Gate Thresholds
MOTION_FROZEN_MAD=0.35
MOTION_FROZEN_RATIO_FAIL=0.60
MOTION_FREEZE_TAIL_FAIL_S=1.0
MOTION_RESIDUAL_PX_MIN=0.30

# Vision Quality Gate Engine (Deterministic Signal QA)
VISION_SHARPNESS_MIN=80.0
VISION_DYNRANGE_MIN=0.30
VISION_QA_STRICT=false
